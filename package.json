{
  "name": "graimmer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rule-based spelling and grammar checker for the browser. No AI, no network.",
  "scripts": {
    "build": "node build/extension.js",
    "harness": "node test/build-harness.js",
    "test": "node test/run.js",
    "test:harness": "npm run harness && node test/verify-harness.mjs",
    "test:selectors": "node test/verify-selectors.mjs",
    "test:e2e": "npm run build && node test/e2e-extension.mjs",
    "test:all": "npm test && npm run test:selectors && npm run test:harness && npm run test:e2e"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "dictionary-en": "^4.0.0",
    "nspell": "^2.1.5"
  }
}
